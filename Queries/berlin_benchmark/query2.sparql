PREFIX bsbm-inst: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/data>
PREFIX bsbm-inst-dataFromProducer1: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/dataFromProducer1/>
PREFIX bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>

SELECT ?label ?comment ?producer ?productFeature ?propertyTextual1 ?propertyTextual2 ?propertyTextual3
 ?propertyNumeric1 ?propertyNumeric2 ?propertyTextual4 ?propertyTextual5 ?propertyNumeric4 
WHERE {
 bsbm-inst-dataFromProducer1:Product30 rdfs:label ?label .
	bsbm-inst-dataFromProducer1:Product30 rdfs:comment ?comment .
	bsbm-inst-dataFromProducer1:Product30 bsbm:producer ?p .
	?p rdfs:label ?producer .
 bsbm-inst-dataFromProducer1:Product30 dc:publisher ?p . 
	bsbm-inst-dataFromProducer1:Product30 bsbm:productFeature ?f .
	?f rdfs:label ?productFeature .
	bsbm-inst-dataFromProducer1:Product30 bsbm:productPropertyTextual1 ?propertyTextual1 .
	bsbm-inst-dataFromProducer1:Product30 bsbm:productPropertyTextual2 ?propertyTextual2 .
 bsbm-inst-dataFromProducer1:Product30 bsbm:productPropertyTextual3 ?propertyTextual3 .
	bsbm-inst-dataFromProducer1:Product30 bsbm:productPropertyNumeric1 ?propertyNumeric1 .
	bsbm-inst-dataFromProducer1:Product30 bsbm:productPropertyNumeric2 ?propertyNumeric2 .
	OPTIONAL { bsbm-inst-dataFromProducer1:Product30 bsbm:productPropertyTextual4 ?propertyTextual4 }
 OPTIONAL { bsbm-inst-dataFromProducer1:Product30 bsbm:productPropertyTextual5 ?propertyTextual5 }
 OPTIONAL { bsbm-inst-dataFromProducer1:Product30 bsbm:productPropertyNumeric4 ?propertyNumeric4 }
}